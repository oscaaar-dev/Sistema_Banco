SECRET_KEY=pon-aqui-una-clave-aleatoria-larga
APP_ENV=development
# Configured locally by scripts.bootstrap_dedicated_mysql. The schema/user names below are legacy technical identifiers; do not rename them without a database migration.
# DATABASE_URL=mysql+pymysql://norte_bcp_app:<local-secret>@127.0.0.1:3307/norte_bcp?charset=utf8mb4
COOKIE_SECURE=false
DEMO_EMAIL=correo-cliente@example.com
ADMIN_EMAIL=correo-admin@example.com
DEMO_PASSWORD=Demo123!
ADMIN_PASSWORD=Admin123!
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tu-login-smtp-de-brevo
SMTP_PASSWORD=tu-clave-smtp-de-brevo
SMTP_FROM=remitente-verificado-en-brevo@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# For Railway Hobby, use Brevo's HTTPS API instead of SMTP:
# EMAIL_TRANSPORT=brevo_api
# Set true in staging to validate Brevo requests without delivering mail (requires API key).
# BREVO_SANDBOX=true
# BREVO_API_KEY=tu-clave-api-de-brevo
# Keep SMTP_FROM set to a verified sender address.

# Canales públicos de contacto (pie de página y cabecera). Los que no se configuren no se muestran.
# Los enlaces deben ser https; el número de WhatsApp va solo con dígitos y código de país.
# NORTE_INSTAGRAM_URL=https://instagram.com/tu_usuario
# NORTE_INSTAGRAM_HANDLE=@tu_usuario
# NORTE_WHATSAPP_NUMBER=51900000000
# NORTE_WHATSAPP_DISPLAY=+51 900 000 000
# NORTE_FACEBOOK_URL=https://facebook.com/tu_pagina
# NORTE_FACEBOOK_NAME=Norte
# NORTE_CONTACT_EMAIL=contacto@example.com
# NORTE_CONTACT_HOURS=Lunes a viernes · 9:00 a 18:00 (horario de demostración)
